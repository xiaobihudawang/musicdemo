<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
  ========================================================================
  MusicMapper.xml —— 音乐模块数据访问层映射文件

  对应 Java 接口：org.example.musicdemo.mapper.MusicMapper
  数据库表：music（歌曲主表）
  关联表：user（用户表，用于关联查询上传者用户名）

  计数说明：
    like_count / comment_count / download_count 是 music 表的反范式冗余字段，
    由数据库触发器在插入/删除关联记录时自动更新，无需在 Java 层面维护。

  核心功能：
    1. 歌曲 CRUD（增删查）
    2. 分页 + 关键字模糊搜索
    3. 本周三大排行榜 TOP10（点赞榜、下载榜、评论榜）
  ========================================================================
-->

<mapper namespace="org.example.musicdemo.mapper.MusicMapper">

    <!--
      resultMap "musicMap"：歌曲完整结果映射

      映射了 music 表的所有字段 + left join user 表额外查询的 username 字段

      字段映射详解：
        id              → id              （主键）
        title           → title           （歌曲标题）
        artist          → artist          （歌手/艺术家）
        description     → description     （歌曲描述/简介）
        file_path       → filePath        （音频文件存储路径）
        file_size       → fileSize        （文件大小，单位字节）
        like_count      → likeCount       （点赞数，反规范化冗余字段）
        comment_count   → commentCount    （评论数，反规范化冗余字段）
        download_count  → downloadCount   （下载数，反规范化冗余字段）
        user_id         → userId          （上传者用户 ID）
        create_time     → createTime      （上传时间）
        username        → username        （上传者用户名，来自 LEFT JOIN user 表）

      反规范化说明：
        like_count、comment_count、download_count 是冗余计数，
        专门从统计表中同步而来，目的是避免每次展示列表时都要 COUNT(*)，
        以空间换时间，提升查询性能
    -->
    <resultMap id="musicMap" type="org.example.musicdemo.entity.Music">
        <id property="id" column="id"/>
        <result property="title" column="title"/>
        <result property="artist" column="artist"/>
        <result property="description" column="description"/>
        <result property="filePath" column="file_path"/>
        <result property="coverPath" column="cover_path"/>
        <result property="lyrics" column="lyrics"/>
        <result property="fileSize" column="file_size"/>
        <result property="likeCount" column="like_count"/>
        <result property="commentCount" column="comment_count"/>
        <result property="downloadCount" column="download_count"/>
        <result property="userId" column="user_id"/>
        <result property="createTime" column="create_time"/>
        <result property="username" column="username"/>
    </resultMap>

    <!--
      ====================== 分页 + 模糊查询 ======================
    -->

    <!--
      findList：分页查询歌曲列表（含关键字模糊搜索）

      业务逻辑：
        1. LEFT JOIN user 表获取上传者用户名
        2. 如果 keyword 不为空，在 title 和 artist 两个字段上做 LIKE 模糊匹配
        3. 按创建时间倒序排列（最新的歌曲在最前面）
        4. 使用 LIMIT offset, size 实现分页

      参数：
        #{keyword} — 搜索关键字（String），可选；支持按歌名或歌手名搜索
        #{offset}  — 分页偏移量（int），计算公式：(pageNum - 1) * pageSize
        #{size}    — 每页条数（int）

      注意：
        LIKE CONCAT('%', #{keyword}, '%') 写法可以防止 SQL 注入，
        比直接在 Java 代码中拼接 % 更安全（MyBatis 会预编译参数）
    -->
    <select id="findList" resultMap="musicMap">
        SELECT m.*, u.username
        FROM music m
        LEFT JOIN `user` u ON m.user_id = u.id
        <where>
            <if test="keyword != null and keyword != ''">
                AND (m.title LIKE CONCAT('%', #{keyword}, '%')
                     OR m.artist LIKE CONCAT('%', #{keyword}, '%'))
            </if>
        </where>
        ORDER BY m.create_time DESC
        LIMIT #{offset}, #{size}
    </select>

    <!--
      countList：统计符合条件的歌曲总数（用于分页器总页数计算）

      与 findList 共用相同的 WHERE 条件（关键字搜索条件一致），
      只是 SELECT 子句从查询具体字段改为 COUNT(*) 聚合

      参数：
        #{keyword} — 搜索关键字（String），可选

      返回值：
        int — 符合条件的总记录数
    -->
    <select id="countList" resultType="int">
        SELECT COUNT(*) FROM music
        <where>
            <if test="keyword != null and keyword != ''">
                AND (title LIKE CONCAT('%', #{keyword}, '%')
                     OR artist LIKE CONCAT('%', #{keyword}, '%'))
            </if>
        </where>
    </select>

    <!-- 根据用户 ID 查询其上传的所有音乐（用于管理员删除用户时清理文件） -->
    <select id="findByUserId" resultMap="musicMap">
        SELECT m.*, u.username
        FROM music m
        LEFT JOIN `user` u ON m.user_id = u.id
        WHERE m.user_id = #{userId}
    </select>

    <!--
      ====================== 单条查询 ======================
    -->

    <!--
      findById：根据 ID 查询歌曲详情（含上传者用户名）

      参数：
        #{id} — 歌曲 ID（Integer）

      用途：
        歌曲详情页展示时调用
    -->
    <select id="findById" resultMap="musicMap">
        SELECT m.*, u.username
        FROM music m
        LEFT JOIN `user` u ON m.user_id = u.id
        WHERE m.id = #{id}
    </select>

    <!--
      ====================== 新增 / 删除 ======================
    -->

    <!--
      insert：新增歌曲记录

      useGeneratedKeys="true" + keyProperty="id"：
        插入后自动将数据库生成的自增主键回填到 Music 对象的 id 属性中，
        方便后续业务逻辑使用（如返回新歌曲 ID 给前端）
    -->
    <insert id="insert" parameterType="org.example.musicdemo.entity.Music" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO music (title, artist, description, file_path, cover_path, lyrics, file_size, user_id)
        VALUES (#{title}, #{artist}, #{description}, #{filePath}, #{coverPath}, #{lyrics}, #{fileSize}, #{userId})
    </insert>

    <!--
      deleteById：根据 ID 删除歌曲

      业务说明：
        删除歌曲前应同时清理关联数据：
          - 删除 comment 表中该歌曲的所有评论
          - 删除 like_record 表中该歌曲的所有点赞记录
          - 删除 download_record 表中该歌曲的所有下载记录
          - （可选）删除服务器上对应的音频文件
        建议在 Service 层使用 @Transactional 保证清理操作的原子性

      参数：
        #{id} — 要删除的歌曲 ID
    -->
    <delete id="deleteById">
        DELETE FROM music WHERE id = #{id}
    </delete>

    <!-- 从冗余字段读取点赞数（无需 COUNT 子查询） -->
    <select id="getLikeCountById" resultType="int">
        SELECT like_count FROM music WHERE id = #{id}
    </select>

    <update id="updateCoverPath">
        UPDATE music SET cover_path = #{coverPath} WHERE id = #{id}
    </update>

    <update id="updateLyrics">
        UPDATE music SET lyrics = #{lyrics} WHERE id = #{id}
    </update>

    <!--
      ====================== 本周排行榜 TOP10 ======================

      三个排行榜的查询结构高度相似：
      1. 从各自的记录表（like_record / download_record / comment）中筛选本周数据
      2. 通过 JOIN 关联 music 表和 user 表获取歌曲信息和上传者用户名
      3. GROUP BY music_id 按歌曲分组
      4. ORDER BY COUNT(*) DESC 按活动次数降序排列
      5. LIMIT 10 截取前 10 名

      时间范围参数：
        #{start} — 本周起始时间（LocalDateTime）
        #{end}   — 本周结束时间（LocalDateTime）
    -->

    <!--
      findWeeklyLikeTop10：本周点赞排行 TOP10

      统计逻辑：
        从 like_record 表中统计本周内每首歌获得的点赞数，
        按点赞数降序排列取前 10。

      业务说明：
        点赞数越高说明歌曲越受欢迎，此排行榜用于"热门推荐"等场景。
    -->
    <select id="findWeeklyLikeTop10" resultMap="musicMap">
        SELECT m.*, u.username, ranked.cnt
        FROM (
            SELECT music_id, COUNT(*) AS cnt
            FROM like_record
            WHERE create_time BETWEEN #{start} AND #{end}
            GROUP BY music_id
            ORDER BY cnt DESC
            LIMIT 10
        ) ranked
        JOIN music m ON ranked.music_id = m.id
        JOIN `user` u ON m.user_id = u.id
        ORDER BY ranked.cnt DESC
    </select>

    <!--
      findWeeklyDownloadTop10：本周下载排行 TOP10

      统计逻辑：
        从 download_record 表中统计本周内每首歌的下载次数，
        按下载量降序排列取前 10。

      业务说明：
        下载量反映歌曲的实际消费热度，与点赞榜互为补充。
    -->
    <select id="findWeeklyDownloadTop10" resultMap="musicMap">
        SELECT m.*, u.username, ranked.cnt
        FROM (
            SELECT music_id, COUNT(*) AS cnt
            FROM download_record
            WHERE create_time BETWEEN #{start} AND #{end}
            GROUP BY music_id
            ORDER BY cnt DESC
            LIMIT 10
        ) ranked
        JOIN music m ON ranked.music_id = m.id
        JOIN `user` u ON m.user_id = u.id
        ORDER BY ranked.cnt DESC
    </select>

    <!--
      findWeeklyCommentTop10：本周评论排行 TOP10

      统计逻辑：
        从 comment 表中统计本周内每首歌收到的评论数，
        按评论活跃度降序排列取前 10。

      业务说明：
        评论量反映歌曲的讨论热度和社区活跃度，
        评论多说明歌曲引发了听众的情感共鸣或话题讨论。
    -->
    <select id="findWeeklyCommentTop10" resultMap="musicMap">
        SELECT m.*, u.username, ranked.cnt
        FROM (
            SELECT music_id, COUNT(*) AS cnt
            FROM comment
            WHERE create_time BETWEEN #{start} AND #{end}
            GROUP BY music_id
            ORDER BY cnt DESC
            LIMIT 10
        ) ranked
        JOIN music m ON ranked.music_id = m.id
        JOIN `user` u ON m.user_id = u.id
        ORDER BY ranked.cnt DESC
    </select>

</mapper>
