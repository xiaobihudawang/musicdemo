flowchart TD
    HTML["HTML 页面<br/>(detail.html 等)"] --> CSS1["base.css<br/>变量/reset/动画"]
    CSS1 --> CSS2["layout.css<br/>navbar/container"]
    CSS2 --> CSS3["components.css<br/>btn/card/form/track"]
    CSS3 --> CSS4["player.css<br/>详情页专用"]
    HTML --> JS1["common.js<br/>Token/Toast/格式化/Navbar/Loading"]
    JS1 --> JS2["api.js<br/>get/post/put/del/postForm"]
    JS2 --> JS3["pages/*.js<br/>当前页面业务逻辑"]
    JS3 --> JS4["app.js<br/>DOMContentLoaded 启动"]
    JS4 -. DOMContentLoaded .-> JS3
    JS4 -. DOMContentLoaded .-> JS1
